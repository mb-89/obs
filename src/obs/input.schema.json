{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "obs input contracts",
  "$defs": {
    "queryReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "conditions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field"],
        "properties": {
          "field": {"type": "string", "minLength": 1, "maxLength": 256},
          "equals": {"type": "string", "maxLength": 512},
          "exists": {"const": true}
        },
        "oneOf": [{"required": ["equals"]}, {"required": ["exists"]}]
      }
    },
    "countQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["where"],
      "properties": {
        "from": {"$ref": "#/$defs/queryReference"},
        "where": {"$ref": "#/$defs/conditions"},
        "distinct": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "cards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "cards"],
      "properties": {
        "version": {"const": 1},
        "cards": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "body"],
            "properties": {
              "title": {"type": "string", "minLength": 1, "maxLength": 256},
              "body": {"type": "string", "maxLength": 100000},
              "metricStyle": {"enum": ["pills", "lines"]},
              "metrics": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["label", "where"],
                  "properties": {
                    "label": {"type": "string", "minLength": 1, "maxLength": 256},
                    "where": {"$ref": "#/$defs/conditions"},
                    "from": {"$ref": "#/$defs/queryReference"},
                    "secondary": {"$ref": "#/$defs/queryReference"},
                    "distinct": {"type": "string", "minLength": 1, "maxLength": 256}
                  }
                }
              }
            }
          }
        }
      }
    },
    "propertyEditor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "field", "label"],
      "properties": {
        "version": {"const": 1},
        "field": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9 _-]*$",
          "maxLength": 128
        },
        "label": {"type": "string", "minLength": 1, "maxLength": 256},
        "maxLength": {"type": "integer", "minimum": 1, "maximum": 100000, "default": 4096}
      }
    }
  }
}
