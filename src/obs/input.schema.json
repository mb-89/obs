{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "obs input contracts",
  "$defs": {
    "queryReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "conditions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field"],
        "properties": {
          "field": {"type": "string", "minLength": 1, "maxLength": 256},
          "equals": {"type": "string", "maxLength": 512},
          "exists": {"const": true},
          "matchCase": {"const": true, "$comment": "capabilities/queries#Conditions: makes equals case-sensitive."}
        },
        "dependentRequired": {"matchCase": ["equals"]},
        "oneOf": [{"required": ["equals"]}, {"required": ["exists"]}]
      }
    },
    "countQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["where"],
      "properties": {
        "from": {"$ref": "#/$defs/queryReference"},
        "where": {"$ref": "#/$defs/conditions"},
        "distinct": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "tone": {"enum": ["neutral", "positive", "warning", "negative"]},
    "toneRules": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "when", "tone"],
        "properties": {
          "value": {"enum": ["primary", "secondary", "remaining"]},
          "when": {"enum": ["zero", "positive"]},
          "tone": {"$ref": "#/$defs/tone"}
        }
      }
    },
    "fragmentLink": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^#[A-Za-z0-9][A-Za-z0-9._~@/-]*(?:\\?tableFilter=(?:[A-Za-z0-9._~!*'()-]|%[0-9A-Fa-f]{2})*)?$"
    },
    "cards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "cards"],
      "properties": {
        "version": {"const": 1},
        "cards": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "body"],
            "properties": {
              "title": {"type": "string", "minLength": 1, "maxLength": 256},
              "body": {"type": "string", "maxLength": 100000},
              "metricStyle": {"enum": ["pills", "lines"]},
              "obs": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "metricsFrom": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["sourceNote", "property", "labelProperty", "distinctProperty", "where"],
                    "properties": {
                      "sourceNote": {"$ref": "#/$defs/queryReference"},
                      "property": {"$ref": "#/$defs/queryReference"},
                      "labelProperty": {"$ref": "#/$defs/queryReference"},
                      "distinctProperty": {"$ref": "#/$defs/queryReference"},
                      "where": {"$ref": "#/$defs/conditions"},
                      "tone": {"$ref": "#/$defs/tone"},
                      "toneRules": {"$ref": "#/$defs/toneRules"},
                      "link": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["note", "groupProperty"],
                        "properties": {
                          "note": {"$ref": "#/$defs/queryReference"},
                          "groupProperty": {"$ref": "#/$defs/queryReference"}
                        }
                      }
                    }
                  }
                }
              },
              "metrics": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["label", "where"],
                  "properties": {
                    "key": {"type": "string", "minLength": 1, "maxLength": 256},
                    "obs": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {"projection": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"}}
                    },
                    "from": {"$ref": "#/$defs/queryReference"},
                    "secondary": {"$ref": "#/$defs/queryReference"},
                    "toneRules": {"$ref": "#/$defs/toneRules"},
                    "label": {"type": "string", "minLength": 1, "maxLength": 256},
                    "where": {"$ref": "#/$defs/conditions"},
                    "denominator": {"$ref": "#/$defs/conditions"},
                    "distinct": {"type": "string", "minLength": 1, "maxLength": 256},
                    "link": {"$ref": "#/$defs/fragmentLink"},
                    "secondaryLink": {"$ref": "#/$defs/fragmentLink"},
                    "tone": {"$ref": "#/$defs/tone"}
                  },
                  "dependentRequired": {"secondary": ["from"], "secondaryLink": ["secondary"]}
                }
              }
            }
          }
        }
      }
    },
    "propertyEditor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "field", "label"],
      "properties": {
        "version": {"const": 1},
        "field": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9 _-]*$",
          "maxLength": 128
        },
        "label": {"type": "string", "minLength": 1, "maxLength": 256},
        "maxLength": {"type": "integer", "minimum": 1, "maximum": 100000, "default": 4096},
        "projection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["blank", "nonblank"],
          "properties": {
            "blank": {"$ref": "#/$defs/projectionFields"},
            "nonblank": {"$ref": "#/$defs/projectionFields"}
          }
        }
      }
    },
    "figureFence": {
      "description": "A figure fence's shared keys; the kind's content and own options are checked by its body schema (document.schema.json, $defs/figureBodies). See capabilities/figures.",
      "type": "object",
      "required": ["version", "kind"],
      "properties": {
        "version": {"const": 1},
        "kind": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "caption": {"oneOf": [
          {"type": "string", "minLength": 1},
          {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1}}
        ]},
        "alt": {"type": "string"},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "projectionFields": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"minLength": 1, "maxLength": 128},
      "additionalProperties": {
        "anyOf": [
          {"$ref": "#/$defs/projectionPrimitive"},
          {"type": "array", "items": {"$ref": "#/$defs/projectionPrimitive"}}
        ]
      }
    },
    "projectionPrimitive": {"type": ["string", "number", "boolean", "null"]},
    "protectedField": {
      "description": "Fields a property editor's projection never writes, compared in lower case; see capabilities/property-editors.",
      "enum": ["title", "kind", "aliases", "term", "definition", "__proto__", "constructor", "prototype"]
    }
  }
}
