{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["version", "cards"],
  "properties": {
    "version": {"const": 1},
    "cards": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["title", "body"],
        "properties": {
          "title": {"type": "string", "minLength": 1, "maxLength": 256},
          "body": {"type": "string", "maxLength": 100000},
          "metricStyle": {"enum": ["pills", "lines"]},
          "obsHtml": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "metricsFrom": {
                "type": "object", "additionalProperties": false,
                "required": ["sourceNote", "property", "labelProperty", "distinctProperty", "where"],
                "properties": {
                  "sourceNote": {"$ref": "#/$defs/queryReference"},
                  "property": {"$ref": "#/$defs/queryReference"},
                  "labelProperty": {"$ref": "#/$defs/queryReference"},
                  "distinctProperty": {"$ref": "#/$defs/queryReference"},
                  "where": {"$ref": "#/$defs/conditions"},
                  "tone": {"enum": ["neutral", "positive", "warning", "negative"]},
                  "toneRules": {"$ref": "#/properties/cards/items/properties/metrics/items/properties/toneRules"},
                  "link": {
                    "type": "object", "additionalProperties": false, "required": ["note", "groupProperty"],
                    "properties": {
                      "note": {"$ref": "#/$defs/queryReference"},
                      "groupProperty": {"$ref": "#/$defs/queryReference"}
                    }
                  }
                }
              }
            }
          },
          "metrics": {
            "type": "array", "maxItems": 64,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["label", "where"],
              "properties": {
                "key": {"type": "string", "minLength": 1, "maxLength": 256},
                "obsHtml": {
                  "type": "object", "additionalProperties": false,
                  "properties": {
                    "projection": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"}
                  }
                },
                "from": {"$ref": "#/$defs/queryReference"},
                "secondary": {"$ref": "#/$defs/queryReference"},
                "toneRules": {
                  "type": "array", "maxItems": 8,
                  "items": {
                    "type": "object", "additionalProperties": false,
                    "required": ["value", "when", "tone"],
                    "properties": {
                      "value": {"enum": ["primary", "secondary", "remaining"]},
                      "when": {"enum": ["zero", "positive"]},
                      "tone": {"enum": ["neutral", "positive", "warning", "negative"]}
                    }
                  }
                },
                "label": {"type": "string", "minLength": 1, "maxLength": 256},
                "where": {"$ref": "#/$defs/conditions"},
                "denominator": {"$ref": "#/$defs/conditions"},
                "distinct": {"type": "string", "minLength": 1, "maxLength": 256},
                "link": {"$ref": "#/$defs/link"},
                "secondaryLink": {"$ref": "#/$defs/link"},
                "tone": {"enum": ["neutral", "positive", "warning", "negative"]}
              },
              "dependentRequired": {"secondary": ["from"], "secondaryLink": ["secondary"]}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "queryReference": {
      "type": "string", "minLength": 1, "maxLength": 2048,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "countQuery": {
      "type": "object", "additionalProperties": false, "required": ["where"],
      "properties": {
        "from": {"$ref": "#/$defs/queryReference"},
        "where": {"$ref": "#/$defs/conditions"},
        "distinct": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "link": {
      "type": "string", "maxLength": 2048,
      "pattern": "^#[A-Za-z0-9][A-Za-z0-9._~@/-]*(?:\\?tableFilter=(?:[A-Za-z0-9._~!*'()-]|%[0-9A-Fa-f]{2})*)?$"
    },
    "conditions": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["field"],
        "properties": {
          "field": {"type": "string", "minLength": 1, "maxLength": 256},
          "equals": {"type": "string", "maxLength": 512},
          "exists": {"const": true},
          "matchCase": {"const": true, "$comment": "capabilities/queries#Conditions: makes equals case-sensitive."}
        },
        "dependentRequired": {"matchCase": ["equals"]},
        "oneOf": [{"required": ["equals"]}, {"required": ["exists"]}]
      }
    }
  }
}
