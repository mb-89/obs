{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adapter.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "command", "contractVersion", "capabilities"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "contractVersion": {"type": "integer", "minimum": 1},
    "capabilities": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
      "uniqueItems": true
    },
    "options": {
      "description": "The options obs-document --adapter-option NAME=VALUE may pass. A boolean option is passed as --NAME when its value is true and left out when it is false.",
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]*$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "summary"],
        "properties": {
          "type": {"const": "boolean"},
          "summary": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
