{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sankey.schema.json",
  "description": "A Sankey graph carried in a FigureDescriptor's data.sankey: staged nodes and weighted links.",
  "$defs": {
    "sankeyGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "nodes",
        "links"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "branchLayout": {
          "const": "split"
        },
        "nodes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "stage"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "stage": {
                "type": "integer",
                "minimum": -1,
                "maximum": 15
              },
              "placement": {
                "enum": [
                  "flow",
                  "above",
                  "below"
                ]
              },
              "order": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "branchOrder": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "branchSource": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "records": {
                "$ref": "#/$defs/recordData"
              },
              "unique": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        },
        "links": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "target",
              "value"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "value": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "label": {
                "type": "string",
                "maxLength": 256
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "originColor": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "series": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "unique": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "order": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "where": {
                "$ref": "#/$defs/recordConditions"
              }
            }
          }
        },
        "data": {
          "$ref": "#/$defs/recordData"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "data"
            ]
          },
          "then": {
            "properties": {
              "links": {
                "items": {
                  "required": [
                    "where"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "recordCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "equals": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "exists": {
          "const": true
        },
        "matchCase": {
          "const": true,
          "$comment": "obs capabilities/queries#Conditions: makes equals case-sensitive."
        }
      },
      "dependentRequired": {
        "matchCase": [
          "equals"
        ]
      },
      "oneOf": [
        {
          "required": [
            "equals"
          ],
          "not": {
            "required": [
              "exists"
            ]
          }
        },
        {
          "required": [
            "exists"
          ],
          "not": {
            "required": [
              "equals"
            ]
          }
        }
      ]
    },
    "recordConditions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/recordCondition"
      }
    },
    "recordData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "where"
      ],
      "properties": {
        "where": {
          "$ref": "#/$defs/recordConditions"
        }
      }
    }
  },
  "$ref": "#/$defs/sankeyGraph"
}
