{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "figure.schema.json",
  "description": "A neutral FigureDescriptor with data, panel geometry, axes, and provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "data", "panels", "provenance"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "data": {"$ref": "#/$defs/data"},
    "panels": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/panel"}},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "data": {
      "description": "What the descriptor draws: exactly one shape, traces or sankey (input-model, Figure descriptor).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "traces": {"$ref": "#/$defs/traces"},
        "sankey": {"$ref": "#/$defs/sankeyGraph"},
        "countLabels": {"$ref": "#/$defs/countLabels"}
      },
      "oneOf": [{"required": ["traces"]}, {"required": ["sankey"]}],
      "dependentRequired": {"countLabels": ["sankey"]}
    },
    "traces": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/trace"}},
    "trace": {
      "description": "One series on a panel; its x and y lists have equal length.",
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {"$ref": "#/$defs/values"},
        "y": {"$ref": "#/$defs/values"},
        "label": {"type": "string"},
        "panel": {"$ref": "#/$defs/id"},
        "mode": {"enum": ["lines", "markers", "lines+markers"]},
        "color": {"$ref": "#/$defs/color"}
      }
    },
    "values": {"type": "array", "minItems": 1, "items": {"type": "number"}},
    "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
    "countLabels": {
      "description": "The words a Sankey's counts are shown with.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "unit": {"type": "string", "pattern": "^\\S(.*\\S)?$", "maxLength": 64},
        "unique": {"type": "string", "pattern": "^\\S(.*\\S)?$", "maxLength": 64}
      }
    },
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row", "column", "rowSpan", "columnSpan"],
      "properties": {
        "row": {"type": "integer", "minimum": 0},
        "column": {"type": "integer", "minimum": 0},
        "rowSpan": {"type": "integer", "minimum": 1},
        "columnSpan": {"type": "integer", "minimum": 1}
      }
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scale", "limits", "label"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "scale": {"enum": ["linear", "log"]},
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum"],
          "properties": {"minimum": {"type": "number"}, "maximum": {"type": "number"}}
        },
        "label": {"type": "string"}
      }
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "bounds", "grid", "axes"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "bounds": {"$ref": "#/$defs/bounds"},
        "grid": {"$ref": "#/$defs/grid"},
        "axes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/axis"}}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fingerprint"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "fingerprint": {"type": "string", "minLength": 1}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/input"}}
      }
    },
    "sankeyGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "nodes", "links"],
      "properties": {
        "version": {"const": 1},
        "branchLayout": {"const": "split"},
        "nodes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "stage"],
            "properties": {
              "id": {"type": "string", "minLength": 1, "maxLength": 256},
              "label": {"type": "string", "minLength": 1, "maxLength": 256},
              "stage": {"type": "integer", "minimum": -1, "maximum": 15},
              "placement": {"enum": ["flow", "above", "below"]},
              "order": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "branchOrder": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "branchSource": {"type": "string", "minLength": 1, "maxLength": 256},
              "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
              "records": {"$ref": "#/$defs/recordData"},
              "unique": {"type": "string", "minLength": 1, "maxLength": 128}
            }
          }
        },
        "links": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "target", "value"],
            "properties": {
              "source": {"type": "string", "minLength": 1, "maxLength": 256},
              "target": {"type": "string", "minLength": 1, "maxLength": 256},
              "value": {"type": "number", "exclusiveMinimum": 0},
              "label": {"type": "string", "maxLength": 256},
              "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
              "originColor": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
              "series": {"type": "string", "minLength": 1, "maxLength": 256},
              "unique": {"type": "string", "minLength": 1, "maxLength": 128},
              "order": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "where": {"$ref": "#/$defs/recordConditions"}
            }
          }
        },
        "data": {"$ref": "#/$defs/recordData"}
      },
      "allOf": [
        {
          "if": {"required": ["data"]},
          "then": {"properties": {"links": {"items": {"required": ["where"]}}}}
        }
      ]
    },
    "recordCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field"],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "equals": {"type": "string", "minLength": 1, "maxLength": 256},
        "exists": {"const": true},
        "matchCase": {
          "const": true,
          "$comment": "obs capabilities/queries#Conditions: makes equals case-sensitive."
        }
      },
      "dependentRequired": {"matchCase": ["equals"]},
      "oneOf": [
        {"required": ["equals"], "not": {"required": ["exists"]}},
        {"required": ["exists"], "not": {"required": ["equals"]}}
      ]
    },
    "recordConditions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/recordCondition"}
    },
    "recordData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["where"],
      "properties": {"where": {"$ref": "#/$defs/recordConditions"}}
    }
  }
}
