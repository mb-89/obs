{
  "description": "Bases filter grammar conformance; owner: spec/design_input/generic-tables.md, Bases filter grammar.",
  "records": [
    {
      "id": "a",
      "path": "notes/a.md",
      "frontmatter": {
        "kind": "Item",
        "status": "open",
        "count": 1,
        "flag": true,
        "empty": "",
        "list": ["Item"],
        "nested": {"owner": "Ann"},
        "bottom line": "Kept",
        "items": [{"name": "x", "tags": ["t1"]}, {"name": "y", "note": null}]
      }
    },
    {
      "id": "b",
      "path": "b.md",
      "frontmatter": {
        "kind": "item",
        "status": "closed",
        "count": 1.5,
        "flag": false,
        "empty": null,
        "nested": {"owner": "Bob"},
        "bottom line": null,
        "blank": []
      }
    },
    {
      "id": "c",
      "path": "deep/dir/c.md",
      "frontmatter": {
        "kind": ["Item"],
        "count": "1",
        "flag": "true",
        "a.b": "literal",
        "a": {"b": "nested"}
      }
    },
    {"id": "d", "path": "d.md", "frontmatter": {}},
    {
      "id": "e",
      "path": "notes/e.md",
      "frontmatter": {"count": 1.0, "delta": -2, "flag": 0, "ratio": 0.25, "blank": {}}
    }
  ],
  "cases": [
    {"filter": null, "expected": ["a", "b", "c", "d", "e"]},
    {"filter": "kind == \"Item\"", "expected": ["a"]},
    {"filter": "note.kind == \"Item\"", "expected": ["a"]},
    {"filter": "kind==\"Item\"", "expected": ["a"]},
    {"filter": "kind\t==\t'Item'", "expected": ["a"]},
    {"filter": "kind != \"Item\"", "expected": ["b", "c", "d", "e"]},
    {"filter": "status == 'open'", "expected": ["a"]},
    {"filter": "status == \"Open\"", "expected": []},
    {"filter": "count == 1", "expected": ["a", "e"]},
    {"filter": "count == 1.0", "expected": ["a", "e"]},
    {"filter": "count == \"1\"", "expected": ["c"]},
    {"filter": "count == 1.5", "expected": ["b"]},
    {"filter": "delta == -2", "expected": ["e"]},
    {"filter": "ratio == 0.25", "expected": ["e"]},
    {"filter": "flag == true", "expected": ["a"]},
    {"filter": "flag == false", "expected": ["b"]},
    {"filter": "flag == \"true\"", "expected": ["c"]},
    {"filter": "flag == 0", "expected": ["e"]},
    {"filter": "empty == null", "expected": ["b", "c", "d", "e"]},
    {"filter": "empty != null", "expected": ["a"]},
    {"filter": "empty == \"\"", "expected": ["a"]},
    {"filter": "blank != null", "expected": ["b", "e"]},
    {"filter": "missing == null", "expected": ["a", "b", "c", "d", "e"]},
    {"filter": "list == \"Item\"", "expected": []},
    {"filter": "list != null", "expected": ["a"]},
    {"filter": "nested.owner == \"Ann\"", "expected": ["a"]},
    {"filter": "note.nested.owner != \"Ann\"", "expected": ["b", "c", "d", "e"]},
    {"filter": "note[\"bottom line\"] != null", "expected": ["a"]},
    {"filter": "note[\"bottom line\"] == \"Kept\"", "expected": ["a"]},
    {"filter": "note[\"nested.owner\"] == \"Bob\"", "expected": ["b"]},
    {"filter": "a.b == \"literal\"", "expected": ["c"]},
    {"filter": "items.name == \"x\"", "expected": []},
    {"filter": "items.name != null", "expected": ["a"]},
    {"filter": "items.0.name == \"x\"", "expected": ["a"]},
    {"filter": "items.1.name == \"y\"", "expected": ["a"]},
    {"filter": "items.1.note == null", "expected": ["a", "b", "c", "d", "e"]},
    {"filter": "items.5.name == null", "expected": ["a", "b", "c", "d", "e"]},
    {"filter": "status.length == 4", "expected": []},
    {"filter": "list.length == 1", "expected": []},
    {"filter": "file.name == \"c\"", "expected": ["c"]},
    {"filter": "file.path == \"notes/a.md\"", "expected": ["a"]},
    {"filter": "file.folder == \"notes\"", "expected": ["a", "e"]},
    {"filter": "file.folder == \"deep/dir\"", "expected": ["c"]},
    {"filter": "file.folder == \"\"", "expected": ["b", "d"]},
    {"filter": "file.ext == \"md\"", "expected": ["a", "b", "c", "d", "e"]},
    {"filter": {"and": ["file.folder == \"notes\"", "count == 1"]}, "expected": ["a", "e"]},
    {"filter": {"and": "kind == \"Item\""}, "expected": ["a"]},
    {"filter": {"or": ["kind == \"Item\"", "kind == \"item\""]}, "expected": ["a", "b"]},
    {"filter": {"not": ["kind == \"Item\"", "kind == \"item\""]}, "expected": ["c", "d", "e"]},
    {"filter": {"not": "empty == null"}, "expected": ["a"]},
    {
      "filter": {"and": [
        {"or": ["count == 1", "count == 1.5"]},
        {"not": {"or": ["flag == 0", "file.folder == \"\""]}}
      ]},
      "expected": ["a"]
    }
  ],
  "unsupported": [
    "recordType == \"tag\"",
    {"and": ["kind == \"Item\"", "recordType != null"]},
    "status.contains(\"open\")",
    "file.hasTag(\"x\")",
    "kind = \"Item\"",
    "kind > 1",
    "kind == Item",
    "kind == \"Item\" && flag == true",
    "!flag",
    "kind == \"a\\\"b\"",
    "kind == \"a\\nb\"",
    "kind == 'a\\b'",
    "count == 01",
    "count == 1.",
    "count == +1",
    "file.mtime == 1",
    "formula.total == 1",
    "this.kind == \"Item\"",
    "note.file.name == \"a\"",
    "note[\"file.name\"] == \"a\"",
    "größe == 1",
    "1kind == 1",
    "kind == \"Item\"\n",
    "",
    {"xor": ["kind == \"Item\""]},
    {"and": ["kind == \"Item\""], "or": ["kind == \"item\""]},
    {"and": []},
    {"not": [{"or": []}]},
    {},
    ["kind == \"Item\""],
    1,
    true
  ]
}
