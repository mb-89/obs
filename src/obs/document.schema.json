{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "document.schema.json",
  "description": "A neutral Document. Node types are the structural types $defs/structuralType lists, or capability identifiers from the supplied capability reference.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifest", "chapters", "links", "assets", "records", "semanticResources", "diagnostics", "capabilities"],
  "properties": {
    "schemaVersion": {"const": 1},
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "metadata"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "metadata": {"type": "object"},
        "abstract": {"type": "array", "items": {"$ref": "#/$defs/node"}}
      }
    },
    "chapters": {"type": "array", "items": {"$ref": "#/$defs/chapter"}},
    "links": {"type": "array", "items": {"$ref": "#/$defs/link"}},
    "assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
    "records": {"type": "array", "items": {"$ref": "#/$defs/record"}},
    "semanticResources": {"type": "array", "items": {"$ref": "#/$defs/resource"}},
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["level", "message"],
        "properties": {"level": {"enum": ["error", "warning", "info"]}, "message": {"type": "string", "minLength": 1}}
      }
    },
    "capabilities": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "structuralType": {
      "description": "The node types every adapter renders, whatever capabilities it declares: Markdown's own blocks and inline marks (capabilities/markdown) and frontmatter fields (capabilities/markdown-frontmatter).",
      "enum": [
        "document", "section", "paragraph", "text", "list", "list-item", "code", "quote",
        "table", "table-row", "table-cell", "emphasis", "strong", "strikethrough", "math", "field", "rule"
      ]
    },
    "blockNode": {
      "description": "A block node: never a paragraph's child, always its sibling (capabilities/markdown#Document nodes). An embed is a block node unless it names an asset.",
      "required": ["type"],
      "anyOf": [
        {"properties": {"type": {"enum": [
          "section", "paragraph", "list", "list-item", "quote", "table", "table-row", "table-cell", "rule",
          "registers", "figure-descriptor", "cards-metrics", "callouts"
        ]}}},
        {"properties": {"type": {"const": "embeds"}, "attrs": {"not": {"required": ["asset"]}}}}
      ]
    },
    "node": {
      "type": "object", "additionalProperties": false, "required": ["type", "attrs", "children"],
      "properties": {
        "type": {"$ref": "#/$defs/id"},
        "attrs": {"type": "object"},
        "children": {"type": "array", "items": {"$ref": "#/$defs/node"}},
        "text": {"type": "string"}
      },
      "allOf": [
        {
          "description": "Containers that carry no attributes: a quotation's blocks, a table's rows, a row's cells, and a mark's inline nodes.",
          "if": {"properties": {"type": {"enum": ["quote", "table", "table-row", "emphasis", "strong", "strikethrough"]}}},
          "then": {"properties": {"attrs": {"maxProperties": 0}}}
        },
        {
          "description": "A thematic break: no attributes and no children.",
          "if": {"properties": {"type": {"const": "rule"}}},
          "then": {"properties": {"attrs": {"maxProperties": 0}, "children": {"maxItems": 0}}}
        },
        {
          "description": "A table cell: whether it is a header cell and its authored alignment; its children are inline nodes.",
          "if": {"properties": {"type": {"const": "table-cell"}}},
          "then": {"properties": {"attrs": {
            "type": "object", "additionalProperties": false, "required": ["header"],
            "properties": {"header": {"type": "boolean"}, "align": {"enum": ["left", "center", "right"]}}
          }}}
        },
        {
          "description": "A list: whether it is numbered and whether it was authored tight (no blank line between its items); its children are list-item nodes.",
          "if": {"properties": {"type": {"const": "list"}}},
          "then": {"properties": {"attrs": {
            "type": "object", "additionalProperties": false, "required": ["ordered", "tight"],
            "properties": {"ordered": {"type": "boolean"}, "tight": {"type": "boolean"}}
          }}}
        },
        {
          "description": "TeX math: the formula is text, display is true for a $$ formula.",
          "if": {"properties": {"type": {"const": "math"}}},
          "then": {"required": ["text"], "properties": {"children": {"maxItems": 0}, "attrs": {
            "type": "object", "additionalProperties": false, "required": ["display"],
            "properties": {"display": {"type": "boolean"}}
          }}}
        },
        {
          "description": "One frontmatter string value parsed as inline Markdown; name is its dotted field path (list items by index).",
          "if": {"properties": {"type": {"const": "field"}}},
          "then": {"properties": {"attrs": {
            "type": "object", "additionalProperties": false, "required": ["name"],
            "properties": {"name": {"type": "string", "minLength": 1}}
          }}}
        },
        {
          "description": "A command fence: its authored source; a producer is silent and renders nothing, every other fence carries the output the core captured on an authorized build (capabilities/command-fences).",
          "if": {"properties": {"type": {"const": "command-fences"}}},
          "then": {"properties": {"attrs": {
            "type": "object", "additionalProperties": false, "required": ["source"],
            "properties": {"source": {"type": "string"}, "silent": {"const": true}, "output": {"type": "string"}},
            "oneOf": [{"required": ["silent"]}, {"required": ["output"]}]
          }}}
        },
        {
          "if": {"properties": {"type": {"const": "figure-descriptor"}}},
          "then": {
            "properties": {
              "attrs": {
                "type": "object",
                "additionalProperties": false,
                "required": ["descriptor"],
                "properties": {"descriptor": {"$ref": "figure.schema.json"}}
              }
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "attachments"}}},
          "then": {"properties": {"attrs": {
            "type": "object", "additionalProperties": false, "required": ["asset", "label"],
            "properties": {"asset": {"$ref": "#/$defs/id"}, "label": {"type": "string"}}
          }}}
        },
        {
          "if": {"properties": {"type": {"const": "chapter-inclusion"}}},
          "then": {"properties": {"attrs": {
            "type": "object", "additionalProperties": false, "required": ["id"],
            "properties": {"id": {"$ref": "#/$defs/id"}}
          }}}
        },
        {
          "description": "A callout: its canonical type and its title (the authored one, or the default input-model.md#Callouts names); its children are the parsed body, the same block and inline nodes as chapter content, including nested callouts.",
          "if": {"properties": {"type": {"const": "callouts"}}},
          "then": {"properties": {"attrs": {
            "type": "object", "additionalProperties": false, "required": ["kind", "title"],
            "properties": {"kind": {"$ref": "#/$defs/id"}, "title": {"type": "string"}}
          }}}
        },
        {
          "description": "A cards fence: its authored source and validated spec; its children are one document node per card, in the spec's order, holding that card's body parsed like chapter content.",
          "if": {"properties": {"type": {"const": "cards-metrics"}}},
          "then": {"properties": {
            "attrs": {
              "type": "object", "additionalProperties": false, "required": ["source", "spec"],
              "properties": {"source": {"type": "string"}, "spec": {"type": "object"}}
            },
            "children": {"items": {"properties": {"type": {"const": "document"}, "attrs": {"maxProperties": 0}}}}
          }}
        },
        {
          "description": "A property-editor fence: its authored source and the mapping input.schema.json (propertyEditor) validated.",
          "if": {"properties": {"type": {"const": "property-editors"}}},
          "then": {"properties": {"attrs": {
            "type": "object", "additionalProperties": false, "required": ["source", "spec"],
            "properties": {"source": {"type": "string"}, "spec": {"type": "object"}}
          }}}
        },
        {
          "if": {"properties": {"type": {"enum": ["markdown-frontmatter", "quantities", "references"]}}},
          "then": {"properties": {"attrs": {
            "type": "object", "additionalProperties": false, "required": ["metadata"],
            "properties": {"metadata": {"type": "object"}}
          }}}
        },
        {
          "if": {"properties": {"type": {"enum": ["queries", "count-query"]}}},
          "then": {"properties": {"attrs": {
            "type": "object", "additionalProperties": false, "required": ["query"],
            "properties": {"query": {"type": "object"}}
          }}}
        },
        {
          "if": {"properties": {"type": {"const": "profiles"}}},
          "then": {"properties": {"attrs": {
            "type": "object", "additionalProperties": false, "required": ["profile"],
            "properties": {"profile": {"type": "object"}}
          }}}
        },
        {
          "if": {"properties": {"type": {"const": "wikilinks"}}},
          "then": {"properties": {"attrs": {
            "type": "object", "additionalProperties": false, "required": ["target", "chapter", "heading", "label"],
            "properties": {
              "target": {"type": "string", "minLength": 1}, "chapter": {"$ref": "#/$defs/chapterReference"},
              "heading": {"type": "string"}, "label": {"type": "string", "minLength": 1}
            }
          }}}
        },
        {
          "if": {"properties": {"type": {"const": "embeds"}}},
          "then": {"properties": {"attrs": {
            "type": "object", "additionalProperties": false, "required": ["target", "chapter"],
            "properties": {
              "target": {"type": "string", "minLength": 1}, "chapter": {"$ref": "#/$defs/chapterReference"},
              "asset": {"description": "The id in assets of an embedded vault file that is not a note; absent for a note.", "$ref": "#/$defs/id"}
            }
          }}}
        },
        {
          "if": {"properties": {"type": {"const": "registers"}}},
          "then": {"properties": {"attrs": {
            "description": "A register embed with everything an adapter renders it from (capabilities/registers, Document node).",
            "type": "object", "additionalProperties": false, "required": ["target", "heading", "base", "view", "rows"],
            "properties": {
              "target": {"type": "string", "minLength": 1}, "heading": {"type": "string"},
              "base": {"description": "The embedded Base definition; base.schema.json validates it.", "type": "object", "required": ["views"]},
              "view": {"description": "The index in base.views of the view heading names; null embeds all views.", "oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
              "rows": {
                "description": "Per view of base.views, in order: the ids of the records it selects, of the record type its obsHtml.records names.",
                "type": "array", "items": {"type": "array", "items": {"$ref": "#/$defs/id"}}
              }
            }
          }}}
        }
      ]
    },
    "chapterReference": {
      "description": "The id of the included chapter a note link resolves to, home for the manifest, or null when the target does not exist.",
      "oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]
    },
    "chapter": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "content", "children"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "title": {"type": "string", "minLength": 1},
        "content": {"type": "array", "items": {"$ref": "#/$defs/node"}},
        "children": {"type": "array", "items": {"$ref": "#/$defs/chapter"}},
        "metadata": {"type": "object"},
        "toc": {"const": false, "description": "An included note the manifest does not list; it follows the TOC chapters at the top level."}
      }
    },
    "link": {
      "type": "object", "additionalProperties": false, "required": ["id", "href", "label"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "href": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1}}
    },
    "asset": {
      "description": "A file the Document references as an image or a marked attachment (architecture.md, Asset bytes). A vault file carries its path and bytes, so an adapter never reads the vault; a remote (http or https) image carries the bytes fetched at build time and no path, or neither when the fetch failed.",
      "type": "object", "additionalProperties": false, "required": ["id", "href", "mediaType"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "href": {"description": "The reference as authored.", "type": "string", "minLength": 1},
        "mediaType": {"type": "string", "minLength": 1},
        "path": {"description": "The vault-relative POSIX path of the referenced file.", "type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$)).+$"},
        "data": {"description": "The file's bytes, base64-encoded (RFC 4648, padded).", "type": "string", "contentEncoding": "base64", "pattern": "^[A-Za-z0-9+/]*={0,2}$"}
      },
      "dependentRequired": {"path": ["data"]},
      "if": {"required": ["data"], "not": {"required": ["path"]}},
      "then": {"properties": {"href": {"pattern": "^[Hh][Tt][Tt][Pp][Ss]?://"}}}
    },
    "record": {
      "description": "A selectable row for Bases and queries, of one record type; a Base view selects one type with obsHtml.records (capabilities/registers). The fields of a row other than a note are its own fields (generic-tables, Bases filter grammar).",
      "type": "object", "additionalProperties": false, "required": ["id", "type", "fields"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"enum": ["note", "chapter", "tag", "glossary", "documentMetadata", "documentHistory"]},
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$)).+\\.md$"},
        "note": {"description": "The id of the note record the row comes from; a chapter or glossary row's other properties resolve on its frontmatter and path.", "$ref": "#/$defs/id"},
        "fields": {"type": "object"},
        "ignored": {"const": true, "description": "Present on an ignored note: queries and Bases never select it or a row it owns (markdown-frontmatter, Ignored notes)."}
      },
      "allOf": [
        {
          "description": "A note: one vault note, its vault-relative POSIX path and its frontmatter as fields.",
          "if": {"properties": {"type": {"const": "note"}}},
          "then": {"required": ["path"], "not": {"required": ["note"]}},
          "else": {"not": {"anyOf": [{"required": ["path"]}, {"required": ["ignored"]}]}}
        },
        {
          "description": "A chapter: one manifest TOC chapter, in TOC order; depth 0 at the top level and slug its chapter id.",
          "if": {"properties": {"type": {"const": "chapter"}}},
          "then": {"required": ["note"], "properties": {"fields": {
            "additionalProperties": false, "required": ["chapter", "title", "depth", "slug", "sourcePath"],
            "properties": {
              "chapter": {"type": "string"}, "title": {"type": "string"}, "depth": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
              "slug": {"$ref": "#/$defs/id"}, "sourcePath": {"type": "string"}
            }
          }}}
        },
        {
          "description": "A tag: one mark of a marked paragraph (capabilities/marks); text is the paragraph without its marks, source its note's title.",
          "if": {"properties": {"type": {"const": "tag"}}},
          "then": {"required": ["note"], "properties": {"fields": {
            "additionalProperties": false, "required": ["sourcePath", "type", "label", "text", "source"],
            "properties": {
              "sourcePath": {"type": "string"}, "type": {"type": "string"}, "label": {"type": "string"},
              "text": {"type": "string"}, "source": {"type": "string"}
            }
          }}}
        },
        {
          "description": "A glossary term: one note with kind glossary (input-model, Glossary).",
          "if": {"properties": {"type": {"const": "glossary"}}},
          "then": {"required": ["note"], "properties": {"fields": {
            "additionalProperties": false, "required": ["sourcePath", "term", "definition", "aliases"],
            "properties": {"sourcePath": {"type": "string"}, "term": {}, "definition": {}, "aliases": {"type": "array"}}
          }}}
        },
        {
          "description": "A document metadata entry: one manifest frontmatter key other than history and obsHtml, its value as authored.",
          "if": {"properties": {"type": {"const": "documentMetadata"}}},
          "then": {"not": {"required": ["note"]}, "properties": {"fields": {
            "additionalProperties": false, "required": ["key", "value"], "properties": {"key": {"type": "string"}, "value": {}}
          }}}
        },
        {
          "description": "A document history entry: one item of the manifest's history, its keys as authored and date empty when it has none.",
          "if": {"properties": {"type": {"const": "documentHistory"}}},
          "then": {"not": {"required": ["note"]}, "properties": {"fields": {"required": ["date"]}}}
        }
      ]
    },
    "resource": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "attrs"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"$ref": "#/$defs/id"}, "attrs": {"type": "object"}}
    }
  }
}
