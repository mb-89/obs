{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "source"],
  "properties": {
    "version": {"const": 1},
    "kind": {"enum": ["plot", "svg", "sankey", "image"]},
    "source": {"type": "string", "minLength": 1},
    "sourceNote": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*\\.md$)[^\\\\:#?]+$"
    },
    "fallback": {"type": "string", "pattern": "\\.svg$"},
    "caption": {"oneOf": [
      {"type": "string", "minLength": 1},
      {"type": "array", "minItems": 1, "maxItems": 64,
       "items": {"type": "string", "minLength": 1}}
    ]},
    "alt": {"type": "string"},
    "countLabels": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "unit": {"type": "string", "pattern": "^\\S(.*\\S)?$", "maxLength": 64},
        "unique": {"type": "string", "pattern": "^\\S(.*\\S)?$", "maxLength": 64}
      }
    },
    "domain": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
    "samples": {"type": "integer", "minimum": 2, "maximum": 2000},
    "equations": {
      "type": "object", "minProperties": 1, "maxProperties": 64,
      "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
      "additionalProperties": {"type": "string", "maxLength": 2048}
    },
    "traces": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["y", "label"],
        "properties": {
          "y": {"type": "string"}, "label": {"type": "string"},
          "at": {"oneOf": [
            {"type": "array", "items": {"type": "number"}, "minItems": 1, "maxItems": 2000},
            {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"}
          ]},
          "mode": {"enum": ["lines", "markers", "lines+markers"]},
          "marker": {"enum": ["circle", "square"]},
          "legend": {"type": "boolean"},
          "axis": {"enum": ["y", "y2"]},
          "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
          "width": {"type": "number", "minimum": 0.1, "maximum": 10},
          "dash": {"enum": ["solid", "dash", "dot", "dashdot"]}
        }
      }
    },
    "layout": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "title": {"type": ["string", "object"]},
        "margin": {"type": "object"},
        "paper_bgcolor": {"type": "string"},
        "plot_bgcolor": {"type": "string"},
        "font": {"type": "object"},
        "xaxis": {"type": "object"},
        "yaxis": {"type": "object"},
        "yaxis2": {"type": "object"},
        "legend": {"type": "object"},
        "shapes": {"type": "array", "maxItems": 64, "items": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "type": {"const": "line"}, "x0": {"type": "number"}, "x1": {"type": "number"},
            "y0": {"type": "number"}, "y1": {"type": "number"},
            "xref": {"enum": ["x", "paper"]}, "yref": {"enum": ["y", "y2", "paper"]},
            "line": {"type": "object"}
          }
        }},
        "annotations": {"type": "array", "maxItems": 64, "items": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "text": {"type": "string"}, "x": {"type": "number"}, "y": {"type": "number"},
            "xref": {"enum": ["x", "paper"]}, "yref": {"enum": ["y", "y2", "paper"]},
            "showarrow": {"type": "boolean"}, "font": {"type": "object"},
            "xanchor": {"enum": ["left", "center", "right"]},
            "yanchor": {"enum": ["top", "middle", "bottom"]}
          }
        }}
      }
    }
  },
  "allOf": [
    {
      "if": {"required": ["countLabels"]},
      "then": {"properties": {"kind": {"const": "sankey"}}}
    },
    {
      "if": {"properties": {"kind": {"enum": ["plot", "svg"]}}},
      "then": {"required": ["fallback"]}
    },
    {
      "if": {"properties": {"kind": {"const": "plot"}}},
      "then": {"required": ["domain", "samples", "equations", "traces"]}
    }
  ],
  "$defs": {
    "sankeyGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "nodes", "links"],
      "properties": {
        "version": {"const": 1},
        "branchLayout": {"const": "split"},
        "nodes": {
          "type": "array", "minItems": 2, "maxItems": 256,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "label", "stage"],
            "properties": {
              "id": {"type": "string", "minLength": 1, "maxLength": 256},
              "label": {"type": "string", "minLength": 1, "maxLength": 256},
              "stage": {"type": "integer", "minimum": -1, "maximum": 15},
              "placement": {"enum": ["flow", "above", "below"]},
              "order": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
              "branchOrder": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
              "branchSource": {"type": "string", "minLength": 1, "maxLength": 256},
              "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
              "records": {"$ref": "#/$defs/recordData"},
              "unique": {"type": "string", "minLength": 1, "maxLength": 128}
            }
          }
        },
        "links": {
          "type": "array", "minItems": 1, "maxItems": 1024,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["source", "target", "value"],
            "properties": {
              "source": {"type": "string", "minLength": 1, "maxLength": 256},
              "target": {"type": "string", "minLength": 1, "maxLength": 256},
              "value": {"type": "number", "exclusiveMinimum": 0},
              "label": {"type": "string", "maxLength": 256},
              "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
              "originColor": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
              "series": {"type": "string", "minLength": 1, "maxLength": 256},
              "unique": {"type": "string", "minLength": 1, "maxLength": 128},
              "order": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
              "where": {"$ref": "#/$defs/recordConditions"}
            }
          }
        },
        "data": {"$ref": "#/$defs/recordData"}
      },
      "allOf": [{
        "if": {"required": ["data"]},
        "then": {"properties": {"links": {"items": {"required": ["where"]}}}}
      }]
    },
    "recordCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field"],
      "properties": {
        "field": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"},
        "equals": {"type": "string", "minLength": 1, "maxLength": 256},
        "exists": {"const": true}
      },
      "oneOf": [
        {"required": ["equals"], "not": {"required": ["exists"]}},
        {"required": ["exists"], "not": {"required": ["equals"]}}
      ]
    },
    "recordConditions": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {"$ref": "#/$defs/recordCondition"}
    },
    "recordData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["where"],
      "properties": {"where": {"$ref": "#/$defs/recordConditions"}}
    }
  }
}
