{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "obs base input",
  "type": "object",
  "required": ["views"],
  "additionalProperties": false,
  "properties": {
    "filters": {"type": ["object", "array", "string"]},
    "properties": {"type": "object"},
    "obs": {
      "$comment": "The core's namespace on a Base: records is every view's default; members belong to a view (generic-tables).",
      "type": "object",
      "additionalProperties": false,
      "properties": {"records": {"$ref": "#/$defs/records"}}
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "order"],
        "additionalProperties": true,
        "properties": {
          "type": {"const": "table"},
          "order": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "\\S"}},
          "obs": {
            "$comment": "The core's namespace on a view: its record type and its ordered members (generic-tables).",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "records": {"$ref": "#/$defs/records"},
              "members": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["path"],
                  "additionalProperties": false,
                  "properties": {"path": {"type": "string", "minLength": 1}, "label": {"type": "string"}}
                }
              }
            }
          }
        }
      }
    }
  },
  "patternProperties": {
    "^obs[A-Z][A-Za-z0-9]*$": {
      "$comment": "An adapter's namespace (capabilities/trusted-actions): the adapter's alone; the core neither reads nor validates it.",
      "type": "object"
    }
  },
  "$defs": {
    "records": {
      "$comment": "The record type of a view's rows (capabilities/registers); document.schema.json $defs/record defines each.",
      "enum": ["note", "chapter", "tag", "glossary", "documentMetadata", "documentHistory"]
    },
    "comparison": {
      "$comment": "Bases comparison syntax for the core evaluator; groups: name, bracketed name, operator, literal. A test keeps it equal to the interim adapter's pattern.",
      "type": "string",
      "pattern": "^(?:([A-Za-z][A-Za-z0-9_.]*)|note\\[\"([^\"\\r\\n]+)\"\\])[ \\t]*(==|!=)[ \\t]*(null|true|false|-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?|\"[^\"\\\\\\r\\n]*\"|'[^'\\\\\\r\\n]*')$"
    }
  }
}
