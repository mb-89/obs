{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "obs-html project configuration",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "type": "string",
            "description": "Schema location used by JSON-aware editors."
        },
        "schemaVersion": {
            "const": 1
        },
        "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "manifestFilename": {
                    "type": "string",
                    "pattern": "^[^/\\\\]+\\.md$"
                },
                "cssSnippetFolder": {
                    "$ref": "cfg.schema.json#/properties/input/properties/cssSnippetFolder"
                }
            }
        },
        "execution": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "commandTimeoutSeconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 300
                }
            }
        },
        "artifact": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "dataCompression": {
                    "$ref": "cfg.schema.json#/properties/artifact/properties/dataCompression"
                },
                "assetIndex": {
                    "$ref": "cfg.schema.json#/properties/artifact/properties/assetIndex"
                },
                "reading": {
                    "$ref": "cfg.schema.json#/$defs/reading"
                },
                "hoverCard": {
                    "$ref": "cfg.schema.json#/$defs/hoverCard"
                },
                "print": {"$ref": "cfg.schema.json#/$defs/print"},
                "printReadyTimeoutMilliseconds": {
                    "$ref": "cfg.schema.json#/properties/artifact/properties/printReadyTimeoutMilliseconds"
                },
                "tablePageSize": {
                    "type": "integer",
                    "minimum": 1
                },
                "tableDetailFontSizePoints": {
                    "$ref": "cfg.schema.json#/properties/artifact/properties/tableDetailFontSizePoints"
                },
                "tableColumnMinimumPixels": {
                    "$ref": "cfg.schema.json#/properties/artifact/properties/tableColumnMinimumPixels"
                },
                "tableCompactColumnMinimumPixels": {
                    "$ref": "cfg.schema.json#/properties/artifact/properties/tableCompactColumnMinimumPixels"
                },
                "dockPaneMinimumPixels": {
                    "$ref": "cfg.schema.json#/properties/artifact/properties/dockPaneMinimumPixels"
                },
                "borderedTags": {
                    "$ref": "cfg.schema.json#/$defs/borderedTags"
                },
                "facetDistinctRatio": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1
                },
                "filterPresets": {
                    "$ref": "cfg.schema.json#/$defs/filterPresets"
                }
            }
        }
    }
}