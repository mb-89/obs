{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "obs base input",
  "type": "object",
  "required": ["views"],
  "additionalProperties": false,
  "properties": {
    "filters": {"type": ["object", "array", "string"]},
    "properties": {"type": "object"},
    "obsHtml": {
      "$comment": "Adapter namespace; the core reads records and members to select notes (generic-tables).",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path"],
            "properties": {"path": {"type": "string", "minLength": 1}, "label": {"type": "string"}}
          }
        }
      }
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "order"],
        "additionalProperties": true,
        "properties": {
          "type": {"const": "table"},
          "order": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "\\S"}}
        }
      }
    }
  },
  "$defs": {
    "comparison": {
      "$comment": "Bases comparison syntax for the core evaluator; groups: name, bracketed name, operator, literal. A test keeps it equal to the interim adapter's pattern.",
      "type": "string",
      "pattern": "^(?:([A-Za-z][A-Za-z0-9_.]*)|note\\[\"([^\"\\r\\n]+)\"\\])[ \\t]*(==|!=)[ \\t]*(null|true|false|-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?|\"[^\"\\\\\\r\\n]*\"|'[^'\\\\\\r\\n]*')$"
    }
  }
}
