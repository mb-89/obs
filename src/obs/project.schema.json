{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "obs project input configuration",
  "description": "The core's keys of a vault's project configuration, which the core validates and applies; every other top-level key the Document carries unread as projectConfig.settings (architecture.md, Project configuration).",
  "type": "object",
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manifestFilename": {"type": "string", "pattern": "^[^/\\\\]+\\.md$"},
        "cssSnippetFolder": {"type": "string", "pattern": "^(?!/)(?!(.*/)?\\.\\.(/|$))[^:\\\\]*[^:\\\\/]$"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commandTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 300}
      }
    }
  }
}
